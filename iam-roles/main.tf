resource "aws_iam_role" "cluster" { name = "${var.name}-cluster" assume_role_policy = jsonencode({ Version="2012-10-17", Statement=[{Effect="Allow",Principal={Service="eks.amazonaws.com"},Action="sts:AssumeRole"}] }) }
resource "aws_iam_role" "node" { name = "${var.name}-node" assume_role_policy = jsonencode({ Version="2012-10-17", Statement=[{Effect="Allow",Principal={Service="ec2.amazonaws.com"},Action="sts:AssumeRole"}] }) }
